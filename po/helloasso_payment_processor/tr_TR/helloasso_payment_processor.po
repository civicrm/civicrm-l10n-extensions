"Üretim kimlik doğrulama ekranı kipi, üretim istemci kimliği ve istemci "
"parolası yapılandırılana kadar kilitlenir."

#: helloasso_payment_processor.php
msgid "HelloAsso production authorization screen"
msgstr "HelloAsso üretim kimlik doğrulama ekranı"

