#: CRM/Contact/Form/APIKey.php
msgid "You do not have permission to edit API keys for this contact."
msgstr "Vous n'êtes pas autorisé(e) à modifier les clés API associées à ce contact."

#: CRM/Contact/Form/APIKey.php CRM/Contact/Page/View/APIKey.php apikey.php
#: templates/CRM/Contact/Form/APIKey.tpl
msgid "API Key"
msgstr "Clef API"

#: CRM/Contact/Form/APIKey.php
msgid "Save"
msgstr "Enregistrer"

#: CRM/Contact/Form/APIKey.php
msgid "Cancel"
msgstr "Annuler"

#: CRM/Contact/Page/View/APIKey.php
msgid "The administrator has restricted the ability to view the site key."
msgstr "L'administrateur a restreint l'accès à la clé du site."

#: CRM/Contact/Page/View/APIKey.php
msgid "Add API Key"
msgstr "Ajouter un clé API"

#: CRM/Contact/Page/View/APIKey.php
msgid "Edit API Key"
msgstr "Modifier la clé API"

#: apikey.php
msgid "APIKey"
msgstr "Clé API"

#: apikey.php
msgid "View own API key"
msgstr "Consulter sa propre clé API"

#: apikey.php
msgid ""
"Allows contacts to view their own API key on their contact summary "
"screen/record."
msgstr "Permet aux contacts de consulter leur propre clé API sur l'écran/la fiche récapitulative de leur contact."

#: apikey.php
msgid "Edit own API key"
msgstr "Éditer sa propre clé API"

#: apikey.php
msgid ""
"Allows contacts to edit their own API key on their contact summary "
"screen/record"
msgstr "Permet aux contacts de modifier leur propre clé API depuis l'écran/la fiche de présentation de leur contact"

#: apikey.php
msgid "View site key"
msgstr "Consulter la clé du site"

#: apikey.php
msgid ""
"Allows contacts to view the site key on their contact summary screen/record."
msgstr "Permet aux contacts de consulter la clé du site depuis l'écran ou la fiche récapitulative de leur contact."

#: apikey.php
msgid "View all API keys"
msgstr "Consulter toutes les clés API"

#: apikey.php
msgid "Allows users to view API keys for all contacts."
msgstr "Permet aux utilisateurs de consulter les clés API de tous les contacts."

#: apikey.php
msgid "Edit all API keys"
msgstr "Modifier toutes les clés API"

#: apikey.php
msgid "Allows users to edit API keys for all contacts."
msgstr "Permet aux utilisateurs de modifier les clés API de tous les contacts."

#: templates/CRM/Contact/Form/APIKey.tpl
msgid "Generate"
msgstr "Générer"

#: templates/CRM/Contact/Page/View/APIKey.tpl
msgid "API Keys"
msgstr "Clés API"

#: templates/CRM/Contact/Page/View/APIKey.tpl
msgid "Your API key is"
msgstr "Votre clé API est"

#: templates/CRM/Contact/Page/View/APIKey.tpl
msgid "You are not authorized to display this API Key."
msgstr "Vous n'êtes pas autorisé(e) à afficher cette clé API."

#: templates/CRM/Contact/Page/View/APIKey.tpl
msgid "The Site Key is"
msgstr "La clé du site est"

#: templates/CRM/Contact/Page/View/APIKey.tpl
msgid "You are not authorized to display the Site Key."
msgstr "Vous n'êtes pas autorisé(e) à afficher la clé du site."
