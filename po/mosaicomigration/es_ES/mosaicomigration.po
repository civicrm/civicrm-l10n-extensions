#: mosaicomigration.php
msgid "Mosaico Extension Directory Changes"
msgstr "Cambios en el Directorio de extensión Mosaico"

#: templates/CRM/Mosaicomigration/Form/Migration.tpl
msgid ""
"<strong>Example for Replace Domain Name:</strong><br/>\n"
"      Current Value : https://www.oldexample.org   , New Value : https://www.newexample.org<br/> OR<br/>\n"
"      Current Value : https://old.example.org , New Value : https://new.example.org<br/><br/>\n"
"\n"
"      <strong>Example for Replace Extension Path:</strong><br/>\n"
"      Current Value : sites/default/files/civicrm/ext/uk.co.vedaconsulting.mosaico , New Value :\n"
"      sites/default/civicrm/extensions/uk.co.vedaconsulting.mosaico,<br/>\n"
"      make sure new extension directory path exists.\n"
"    "
msgstr ""
"<strong>Ejemplo para reemplazar el nombre de dominio:<br/>\n"
"     Valor Actual : https://www.oldexample.org   , Nuevo Valor : https://www.newexample.org<br/> OR<br/>\n"
"      Valor Actual : https://old.example.org , Nuevo Valor : https://new.example.org<br/><br/>\n"
"\n"
"      <strong>Ejemplo para reemplazar la ruta de extensión:</strong><br/>\n"
"      Valor Actual : sites/default/files/civicrm/ext/uk.co.vedaconsulting.mosaico , Nuevo Valor :\n"
"      sites/default/civicrm/extensions/uk.co.vedaconsulting.mosaico,<br/>\n"
"     asegúrese de que exista la ruta del directorio de la nueva extensión.\n"
"    "
