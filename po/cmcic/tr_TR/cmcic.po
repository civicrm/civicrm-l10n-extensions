#: CRM/Cmcic/Page/Cmcic.php
msgid "Unable to start the Monetico checkout."
msgstr "Monetico ödemesi başlatılamadı."

#: CRM/Cmcic/Page/Cmcic.php templates/CRM/Cmcic/Page/Cmcic.tpl
msgid ""
"Please Click the pay now button if you are not automatically redirected"
msgstr "Otomatik olarak yönlendirilmezseniz lütfen \"Öde\" düğmesine tıklayın"

#: CRM/Cmcic/Page/Cmcic.php templates/CRM/Cmcic/Page/Cmcic.tpl
msgid "Pay Now"
msgstr "Öde"

#: CRM/Core/Payment/Cmcic.php CRM/Core/Payment/cmcic.mgd.php
msgid "CMCIC"
msgstr "CMCIC"

#: CRM/Core/Payment/Cmcic.php
msgid ""
"POS terminal number is not set in the Administer &raquo; System Settings "
"&raquo; Payment Processors"
msgstr ""
"\"Yönetim\" &amp;raquo; \"Sistem ayarları\" &amp;raquo; \"Ödeme aracıları\" "
"bölümünden POS uçbirimi numarası ayarlanmamış"

#: CRM/Core/Payment/Cmcic.php
msgid ""
"Merchant security key is not set in the Administer &raquo; System Settings "
"&raquo; Payment Processors"
msgstr ""
"\"Yönetim\" &amp;raquo; \"Sistem ayarları\" &amp;raquo; \"Ödeme aracıları\" "
"bölümünden \"Satıcı güvenlik anahtarı\" ayarlanmamış"

#: CRM/Core/Payment/Cmcic.php
msgid "This function is not implemented"
msgstr "Bu özellik eklenmemiş"

#: CRM/Core/Payment/Cmcic.php
msgid "Unable to prepare the payment reference."
msgstr "Ödeme başvurusu hazırlanamadı."

#: CRM/Core/Payment/Cmcic.php
msgid ""
"Monetico online refunds are disabled. Enable setting cmcic_enable_refunds to"
" proceed."
msgstr ""
"Monetico çevrim içi geri ödemeleri kapatılmış. İlerlemek için "
"cmcic_enable_refunds ayarını açın."

#: CRM/Core/Payment/Cmcic.php
msgid "Could not determine contribution reference for refund."
msgstr "Geri ödemenin katkı başvurusu belirlenemedi."

#: CRM/Core/Payment/Cmcic.php
msgid "Refund amount must be greater than zero."
msgstr "Geri ödeme tutarı sıfırdan büyük olmalıdır."

#: CRM/Core/Payment/cmcic.mgd.php
msgid "CMCIC (CyberMut)"
msgstr "CMCIC (CyberMut)"

#: Civi/Cmcic/CheckoutOption/CmcicHostedCheckout.php
msgid "You will be redirected to Monetico to complete your payment."
msgstr "Ödemenizi tamamlamak için Monetico üzerine yönlendirileceksiniz."

#: Civi/Cmcic/CheckoutOption/CmcicHostedCheckout.php
msgid "No active Monetico payment processor is available for this mode."
msgstr "Bu kip için etkin bir Monetico ödeme aracısı yok."

#: cmcic.php
msgid "test"
msgstr "deneme"

#: cmcic.php
msgid "production"
msgstr "üretim"

#: cmcic.php
msgid "Monetico: insecure HTTP return URL"
msgstr "Monetico: Güvenli olmayan HTTP dönüş adresi"

#: cmcic.php
msgid "Monetico: server confirmation URL"
msgstr "Monetico: Sunucu doğrulama adresi"
