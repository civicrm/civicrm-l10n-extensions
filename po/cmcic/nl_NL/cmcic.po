#: CRM/Cmcic/Page/Cmcic.php
msgid "Unable to start the Monetico checkout."
msgstr "Het afrekenen bij Monetico kan niet worden gestart."

#: CRM/Cmcic/Page/Cmcic.php templates/CRM/Cmcic/Page/Cmcic.tpl
msgid ""
"Please Click the pay now button if you are not automatically redirected"
msgstr ""
"Klik op de knop 'Nu betalen' als u niet automatisch wordt doorgestuurd"

#: CRM/Cmcic/Page/Cmcic.php templates/CRM/Cmcic/Page/Cmcic.tpl
msgid "Pay Now"
msgstr "Nu betalen"

#: CRM/Core/Payment/Cmcic.php CRM/Core/Payment/cmcic.mgd.php
msgid "CMCIC"
msgstr "CMCIC"

#: CRM/Core/Payment/Cmcic.php
msgid ""
"POS terminal number is not set in the Administer &raquo; System Settings "
"&raquo; Payment Processors"
msgstr ""
"POS-terminalnumber is niet ingesteld, Beheer &raquo; Systeeminstellingen "
"&raquo; Betaalmethode"

#: CRM/Core/Payment/Cmcic.php
msgid ""
"Merchant security key is not set in the Administer &raquo; System Settings "
"&raquo; Payment Processors"
msgstr ""
"Merchant-Key is niet ingesteld, Beheer &raquo; Systeeminstellingen &raquo; "
"Betaalmethode"

#: CRM/Core/Payment/Cmcic.php
msgid "This function is not implemented"
msgstr "Deze functie is niet geïmplementeerd"

#: CRM/Core/Payment/Cmcic.php
msgid "Unable to prepare the payment reference."
msgstr "De betalingsreferentie kan niet worden aangemaakt."

#: CRM/Core/Payment/Cmcic.php
msgid ""
"Monetico online refunds are disabled. Enable setting cmcic_enable_refunds to"
" proceed."
msgstr ""
"Online terugbetalingen via Monetico zijn uitgeschakeld. Schakel de "
"instelling `cmcic_enable_refunds` in om door te gaan. "

#: CRM/Core/Payment/Cmcic.php
msgid "Could not determine contribution reference for refund."
msgstr ""
"De referentie van de bijdrage voor de terugbetaling kon niet worden "
"vastgesteld."

#: CRM/Core/Payment/Cmcic.php
msgid "Refund amount must be greater than zero."
msgstr "Het terug te betalen bedrag moet groter zijn dan nul."

#: CRM/Core/Payment/cmcic.mgd.php
msgid "CMCIC (CyberMut)"
msgstr "CMCIC (CyberMut)"

#: Civi/Cmcic/CheckoutOption/CmcicHostedCheckout.php
msgid "You will be redirected to Monetico to complete your payment."
msgstr "Je wordt doorgestuurd naar Monetico om je betaling af te ronden."

#: Civi/Cmcic/CheckoutOption/CmcicHostedCheckout.php
msgid "No active Monetico payment processor is available for this mode."
msgstr ""
"Er is geen actieve Monetico-betalingsverwerker beschikbaar voor deze modus."

