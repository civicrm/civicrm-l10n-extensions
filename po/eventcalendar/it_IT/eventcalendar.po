msgid ""
"You may need to clear caches and reset paths as some menu items have changed"
msgstr "Potrebbe essere necessario svuotare la cache e reimpostare i percorsi poiché alcune voci di menu sono cambiate"

#: CRM/EventCalendar/Upgrader.php
msgid "Success"
msgstr "Successo"

