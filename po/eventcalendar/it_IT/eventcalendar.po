#: templates/CRM/EventCalendar/Page/ManageEventCalendars.tpl
msgid "Calendar Title"
msgstr "Titolo Calendario"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Show Past Events"
msgstr "Mostra Eventi Passati"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Show End Date"
msgstr "Mostra Data Fine"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Show Public Events"
msgstr "Mostra Eventi Pubblici"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Show Only Public or All"
msgstr "Mostra Solo Pubblici o Tutti"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Events By Month"
msgstr "Eventi per Mese"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Use the Month param in the calendar"
msgstr "Usa il parametro Mese nel calendario"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Event Timings"
msgstr "Orari Evento"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Show the event timing"
msgstr "Mostragli orari dell'evento"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Events From Month"
msgstr "Eventi Dal Mese"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "How many months to show events"
msgstr "Per quanti mesi mostrare gli eventi"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Event Type Filters"
msgstr "Filtri Tipo Evento"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Whether to show event type filters"
msgstr "Se mostrare o meno i filtri per tipo di evento"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Week Begins From Day"
msgstr "La Settimana Inizia Dal Giorno"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Recurring Event"
msgstr "Evento Ricorrente"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Enrollment Status"
msgstr "Status Iscrizione"

#: CRM/EventCalendar/DAO/EventCalendar.php
#: templates/CRM/EventCalendar/Page/ManageEventCalendars.tpl
msgid "Default"
msgstr "Predefinito"

#: CRM/EventCalendar/DAO/EventCalendar.php
msgid "Indicates whether this is the default event calendar"
msgstr "Indica se questo è il calendario eventi predefinito"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "Unique EventCalendarEventType ID"
msgstr "ID EventCalendarEventType Univoco"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "FK to Event Calendar"
msgstr "FK al Calendario Eventi"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "Event Type"
msgstr "Tipo Evento"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "Event Type id"
msgstr "ID Tipo Evento"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "Event Color"
msgstr "Colore Evento"

#: CRM/EventCalendar/DAO/EventCalendarEventType.php
msgid "Hex code for event type display color"
msgstr "Codice esadecimale per il colore di visualizzazione del tipo di evento"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Are you sure you want to delete this calendar?"
msgstr "Sei sicuro di voler cancellare questo calendario?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php eventcalendar.php
msgid "Event Calendar Settings"
msgstr "Impostazioni Calendario Eventi"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Set as Default Event Calendar"
msgstr "Imposta come Calendario Eventi Predefinito"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid ""
"Check this box to make this event calendar the default one, Only one "
"calendar can be set as the default at a time."
msgstr "Seleziona questa casella per rendere questo calendario eventi quello predefinito. È possibile impostare un solo calendario come predefinito alla volta."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Event calendar title."
msgstr "Titolo calendario eventi."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show Past Events?"
msgstr "Mostra Eventi Passati?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show past events as well as current/future."
msgstr "Mostra gli eventi passati, così come quelli presenti e futuri."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show End Date?"
msgstr "Mostra Data Fine?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show the event with start and end dates on the calendar."
msgstr "Mostra l'evento con le date di inizio e fine sul calendario."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show Public Events?"
msgstr "Mostra Eventi Pubblici?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show only public events, or all events."
msgstr "Mostra solo eventi pubblici o tutti gli eventi."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show Events by Month?"
msgstr "Mostra Eventi per Mese?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show the month parameter on calendar."
msgstr "Mostra il parametro del mese sul calendario."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show Event Times?"
msgstr "Mostra Orari Eventi?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show the event timings on calendar."
msgstr "Mostra gli orari degli eventi sul calendario."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Events from Month"
msgstr "Eventi dal Mese"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show events from how many months from current month."
msgstr "Mostra gli eventi di quanti mesi a partire dal mese corrente."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Filter Event Types?"
msgstr "Filtra Tipi Evento?"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show event types filter on calendar."
msgstr "Mostra il filtro per tipo di evento sul calendario."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Week begins on"
msgstr "La settimana inizia il"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid ""
"Use weekBegin settings from CiviCRM. You can override settings at Administer"
" > Localization > Date Formats."
msgstr "Usa le impostazioni weekBegin di CiviCRM. Puoi sovrascrivere le impostazioni in Amministrazione > Localizzazione > Formati data."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show recurring events"
msgstr "Mostra eventi ricorrenti"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show only recurring events."
msgstr "Mostra solo eventi ricorrenti."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show enrollment status"
msgstr "Mostra status iscrizione"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Show enrollment status on calendar event."
msgstr "Mostra status iscrizione nel calendario eventi."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Search Kit saved search"
msgstr "Ricerca salvata in Search Kit"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Optionally filter only to events found in this saved search."
msgstr "Facoltativamente filtra solo gli eventi trovati in questa ricerca salvata."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Color"
msgstr "Colore"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Submit"
msgstr "Invia"

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "The Calendar has been saved."
msgstr "Il Calendario è stato salvato."

#: CRM/EventCalendar/Form/EventCalendarSettings.php
msgid "Saved"
msgstr "Salvato"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Manage Event Calendars"
msgstr "Gestisci Calendari Eventi"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "View/Edit"
msgstr "Visualizza/Modifica"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Edit Event Calendar"
msgstr "Modifica Calendario Evento"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Delete"
msgstr "Cancella"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Delete Event Calendar"
msgstr "Cancella Calendario Eventi"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Preview"
msgstr "Anteprima"

#: CRM/EventCalendar/Page/ManageEventCalendars.php
msgid "Preview Event Calendar"
msgstr "Anteprima Calendario Eventi"

#: CRM/EventCalendar/Page/ShowEvents.php
msgid "Event Calendar"
msgstr "Calendario Eventi"

