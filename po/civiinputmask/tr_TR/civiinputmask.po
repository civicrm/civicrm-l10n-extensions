msgstr "Herhangi bir sonuç bulunamadı"

#: js/civi-inputmask.js
msgid "1 result found"
msgstr "1 sonuç bulundu"

#: js/civi-inputmask.js
msgid "%1 results found"
msgstr "%1 sonuç bulundu"

#: managed/Navigation_civiinputmask.mgd.php
msgid "Input Masks"
msgstr "Giriş maskeleri"

#: settings/civiinputmask.setting.php
msgid "Phone number display format"
msgstr "Telefon numarası görüntüleme biçimi"

#: settings/civiinputmask.setting.php
msgid "First-name formatting"
msgstr "Ad biçimlendirmesi"

#: settings/civiinputmask.setting.php
msgid "Last-name formatting"
msgstr "Soyad biçimlendirmesi"

#: settings/civiinputmask.setting.php
msgid "Organization-name formatting"
msgstr "Kuruluş adı biçimlendirmesi"

#: settings/civiinputmask.setting.php
msgid "Street-address formatting"
msgstr "Sokak adresi biçimlendirmesi"

#: settings/civiinputmask.setting.php
msgid "City formatting"
msgstr "İl biçimlendirmesi"

#: settings/civiinputmask.setting.php
msgid "Custom field input-mask rules"
msgstr "Özel alan giriş maskesi kuralları"

#: settings/civiinputmask.setting.php
msgid "Custom field regular-expression rules"
msgstr "Özel alan kurallı ifade kuralları"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid ""
"These settings define the default behavior. Form-specific hooks and data-"
"civi-inputmask-preset attributes remain available for advanced overrides."
msgstr ""
"Bu ayarlar varsayılan davranışı tanımlar. Forma özel kancalar ve data-civi-"
"inputmask-preset özellikleri gelişmiş değişiklikler için kullanılabilir "
"olmayı sürdürür."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "General settings"
msgstr "Genel ayarlar"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "Standard contact fields"
msgstr "Standart kişi alanları"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid ""
"Choose formatting independently for each standard field. Select \"No "
"automatic formatting\" to preserve the value exactly as entered."
msgstr ""
"Her standart alan için bağımsız olarak biçimlendirmeyi seçer. Değerin tam "
"olarak yazıldığı gibi korunması için \"Otomatik biçimlendirilmesin\" olarak "
"seçin."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "Phone numbers"
msgstr "Telefon numaraları"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid ""
"Two-letter ISO code. Leave empty to use CiviCRM's default contact country. "
"If no valid country is available, no country is preselected."
msgstr ""
"İki harfli ISO kodu. Varsayılan CiviCRM kişi ülkesinin kullanılması için boş"
" bırakın. Geçerli bir ülke yoksa, hiçbir ülke önceden seçilmez."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "Comma-separated two-letter ISO codes, in display order."
msgstr ""
"Virgül ile ayrılmış iki harfli ISO kodları, görüntülenme sırasına göre."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid ""
"The stored value is always normalized to E.164. This setting only controls "
"how valid numbers are displayed to users."
msgstr ""
"Kaydedilmiş değer her zaman E.164 biçimine dönüştürülür. Bu ayar yalnızca "
"geçerli sayıların kullanıcılara nasıl görüntüleneceğini belirler."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "%1 active text custom field(s) detected."
msgstr "%1 etkin özel yazı alanı algılandı."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "Active custom field"
msgstr "Etkin özel alan"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "Input mask or formatting"
msgstr "Giriş maskesi veya biçimlendirmesi"

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid ""
"Inputmask regular expression applied in the browser. This is not server-side"
" business validation."
msgstr ""
"Tarayıcıda uygulanacak giriş maskesi kurallı ifadesi. Bu, sunucu tarafında "
"iş doğrulaması değildir."

#: templates/CRM/Civiinputmask/Form/Settings.tpl
msgid "No active text custom field is available on this CiviCRM instance."
msgstr "Bu CiviCRM kopyasında etkin bir özel yazı alanı yok."
