#: js/civi-inputmask.js
msgid ""
"Change country for phone number, currently selected ${countryName} "
"(${dialCode})"
msgstr ""
"Telefon numaraları için ülkeyi değiştirin. Şu anda seçili olan: "
"${countryName} (${dialCode})"

#: js/civi-inputmask.js
msgid "Select country for phone number"
msgstr "Telefon numaraları için ülkeyi seçin"

#: js/civi-inputmask.js
msgid "List of countries"
msgstr "Ülke listesi"

#: js/civi-inputmask.js
msgid "Search"
msgstr "Ara"

#: js/civi-inputmask.js
msgid "Clear search"
msgstr "Aramayı temizle"

#: js/civi-inputmask.js
msgid "Close"
msgstr "Kapat"

