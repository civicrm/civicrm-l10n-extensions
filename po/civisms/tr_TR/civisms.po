#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support the selected message format."
msgstr "Bu hizmet sağlayıcı seçilmiş ileti biçimini desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "A/B content tests currently support text and rich-card campaigns."
msgstr ""
"A/B içerik sınamaları şu anda yazı ve zengin kart kampanyalarını "
"desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Variant B must receive between 1% and 99% of recipients."
msgstr "B çeşidi, alıcıların %1 ile %99 kadarını almalıdır."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Variant B requires a message."
msgstr "B çeşidi için bir ileti gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Variant B requires a card title."
msgstr "B çeşidi için bir kart başlığı gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Variant B requires a card description."
msgstr "B çeşidi için bir kart açıklaması gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php
msgid ""
"The variant B card description must not exceed %1 characters for this "
"provider."
msgstr ""
"Bu hizmet sağlayıcı için B çeşidi kartı açıklaması en fazla %1 karakter "
"uzunluğunda olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Provider template variables require a template reference."
msgstr "Hizmet sağlayıcı kalıp değişkenleri için bir kalıp başvurusu gerekir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Template variables must be a JSON object."
msgstr "Kalıp değişkenleri bir JSON nesnesi olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider template supports at most %1 variables."
msgstr "Bu hizmet sağlayıcı kalıbı en fazla %1 değişkeni destekler."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Template variables must contain named scalar values."
msgstr "Kalıp değişkenleri adlandırılmış sayısal değerler içermelidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Template variables contain invalid JSON: %1"
msgstr "Kalıp değişkenlerinde geçersiz JSON var: %1"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A message is required for a text RCS message."
msgstr "Bir yazı RCS iletisi için bir ileti gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The message must not exceed %1 characters for this provider."
msgstr ""
"Bu hizmet sağlayıcı için ileti en fazla %1 karakter uzunluğunda olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A provider template reference is required."
msgstr "Bir hizmet sağlayıcı kalıbı başvurusu gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The card title must not exceed 200 characters."
msgstr "Kart başlığı en fazla 200 karakter uzunluğunda olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A card description is required."
msgstr "Bir kart açıklaması belirtilmelidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The card description must not exceed %1 characters for this provider."
msgstr ""
"Bu hizmet sağlayıcı için kart açıklaması en fazla %1 karakter uzunluğunda "
"olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "An image is required for a rich card."
msgstr "Zengin bir kart için bir görsel gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support the selected card layout."
msgstr "Bu hizmet sağlayıcı seçilmiş kart düzenini desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support the selected media height."
msgstr "Bu hizmet sağlayıcı seçilmiş ortam yüksekliğini desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support the selected thumbnail position."
msgstr "Bu hizmet sağlayıcı seçilmiş küçük görsel konumunu desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A media file is required for a standalone media message."
msgstr "Bağımsız bir ortam iletisi için bir ortam dosyası gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider requires between %1 and %2 carousel cards."
msgstr "Bu hizmet sağlayıcı %1 ile %2 arasında dönme dolap kartı gerekir."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Every card requires a description."
msgstr "Her kartın bir açıklaması olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid ""
"The title and description together must not exceed %1 characters for this "
"provider."
msgstr ""
"Bu hizmet sağlayıcı için kart başlığı ve açıklaması toplam %1 karakter "
"uzunluğunda olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "An image is required for every carousel card."
msgstr "Her dönme dolap kartı için bir görsel gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support that number of buttons."
msgstr "Bu hizmet sağlayıcı bu sayıda düğmeyi desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid ""
"This provider does not support the selected button action in this message "
"format."
msgstr ""
"Bu hizmet sağlayıcı, bu ileti biçiminde seçilmiş düğme işlemini "
"desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Every action requires a label or text."
msgstr "Her işlemin bir etiketi veya yazısı olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A URL is required for an open URL action."
msgstr "Bir adres açma işlemi için bir adres gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Enter an absolute HTTP or HTTPS URL."
msgstr "Mutlak bir HTTP veya HTTPS adresi yazın."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A phone number is required for a dial action."
msgstr "Bir arama işlemi için bir telefon numarası gereklidir."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support a webview for this URL action."
msgstr ""
"Bu hizmet sağlayıcı, bu adres işlemi için bir internet görünümünü "
"desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A button requires both a label and a URL."
msgstr "Bir düğmenin hem bir etiketi hem de bir adresi olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "The selected provider does not support rich messaging campaigns."
msgstr ""
"Seçilmiş hizmet sağlayıcı zengin ileti gönderme kampanyalarını "
"desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "The rich-message draft could not be found."
msgstr "Zengin ileti taslağı bulunamadı."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Compose rich message"
msgstr "Zengin ileti oluştur"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The draft could not be saved: %1"
msgstr "Taslak kaydedilemedi: %1"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The uploaded media could not be saved: %1"
msgstr "Yüklenen ortam kaydedilemedi: %1"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid ""
"This provider does not support that number of buttons on a carousel card."
msgstr ""
"Bu hizmet sağlayıcı bir dönme dolap kartında bu sayıda düğmeyi desteklemez."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid ""
"This provider does not support the selected button action in a carousel."
msgstr ""
"Bu hizmet sağlayıcı, bir dönme dolap üzerinde seçilmiş düğme işlemini "
"desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Every carousel action requires a label."
msgstr "Her dönme dolap işleminin bir etiketi olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support a webview for this carousel URL action."
msgstr ""
"Bu hizmet sağlayıcı, bu dönme dolap adresi işlemi için bir internet "
"görünümünü desteklemiyor."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Open in external browser"
msgstr "Dış tarayıcıda aç"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "In-app panel (half screen)"
msgstr "Uygulama içi pano (yarım ekran)"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "In-app panel (tall)"
msgstr "Uygulama içi pano (uzun)"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "In-app panel (full screen)"
msgstr "Uygulama içi pano (tam ekran)"

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A webview description requires an enabled webview."
msgstr ""
"Bir internet görünümü açıklaması için etkinleştirilmiş bir internet görünümü"
" olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "This provider does not support webview descriptions."
msgstr "Bu hizmet sağlayıcı internet görünümü açıklamalarını desteklemez."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A webview description cannot exceed 100 characters."
msgstr ""
"Bir internet görünümü açıklaması en fazla 100 karakter uzunluğunda "
"olmalıdır."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid ""
"This provider requires the same action types in the same order on every "
"carousel card."
msgstr ""
"Bu hizmet sağlayıcı için her dönme dolap kartında aynı sırayla aynı işlem "
"türleri bulunmalıdır."

#: CRM/Civisms/Form/CampaignRecipients.php
