#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A message is required for a text RCS message."
msgstr "Voor een RCS-tekstbericht is een bericht vereist."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "An SMS fallback is required when the rich message has no text body."
msgstr ""
"Er is een SMS-fallback vereist wanneer het rich message geen tekstgedeelte "
"bevat."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A card title is required."
msgstr "Een kaarttitel is verplicht."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A card description is required."
msgstr "Een kaartbeschrijving is verplicht."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "The card description must not exceed 500 UTF-8 bytes."
msgstr "De kaartbeschrijving mag niet langer zijn dan 500 UTF-8-bytes."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "An image is required for a rich card."
msgstr "Voor een ‘rich card’ is een afbeelding vereist."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "An image is required for an image-only message."
msgstr ""
"Voor een bericht dat uitsluitend uit afbeeldingen bestaat, is een afbeelding"
" vereist."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A carousel requires between 2 and 8 cards."
msgstr "Voor een carrousel zijn tussen de 2 en 8 kaarten nodig."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Every card requires a title and description."
msgstr "Elke kaart moet een titel en een beschrijving hebben."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "An image is required for every carousel card."
msgstr "Voor elke carrouselkaart is een afbeelding vereist."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "A button requires both a label and a URL."
msgstr "Een knop moet zowel een label als een URL bevatten."

#: CRM/Civisms/Form/CampaignCompose.php CRM/Civisms/Form/Compose.php
msgid "Enter an absolute HTTP or HTTPS URL."
msgstr "Voer een absolute HTTP- of HTTPS-URL in."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "The selected provider does not support rich campaigns."
msgstr "De geselecteerde aanbieder ondersteunt geen uitgebreide campagnes."

#: CRM/Civisms/Form/CampaignCompose.php
msgid "Compose rich message"
msgstr "Een uitgebreid bericht opstellen"

