#: mediascaler.php
msgid "Adjust the contact photo"
msgstr "Adjust the contact photo"

#: mediascaler.php
msgid "Move the point to keep the face inside the %1 frame."
msgstr "Move the point to keep the face inside the %1 frame."

#: mediascaler.php
msgid "Contact photo crop preview"
msgstr "Contact photo crop preview"

#: mediascaler.php
msgid "MediaScaler settings"
msgstr "MediaScaler settings"

#: mediascaler.php
msgid "Activation"
msgstr "Activation"

#: mediascaler.php
msgid ""
"Explicit service calls are always available. Automatic upload processing is "
"optional."
msgstr ""
"Explicit service calls are always available. Automatic upload processing is "
"optional."

#: mediascaler.php
msgid "Contact photos"
msgstr "Contact photos"

#: mediascaler.php
msgid "Policy for the primary image_URL contact photo."
msgstr "Policy for the primary image_URL contact photo."

#: mediascaler.php
msgid "Other image files"
msgstr "Other image files"

#: mediascaler.php
msgid "Policy for images stored through CiviCRM file fields and attachments."
msgstr "Policy for images stored through CiviCRM file fields and attachments."

#: mediascaler.php
msgid "Invalid image upload. Check its format, dimensions and file size."
msgstr "Invalid image upload. Check its format, dimensions and file size."

#: mediascaler.php
msgid "The image could not be normalized. Try a JPEG, PNG or WebP file."
msgstr "The image could not be normalised. Try a JPEG, PNG or WebP file."

#: mediascaler.php
msgid "The image was uploaded but MediaScaler could not normalize it."
msgstr "The image was uploaded but MediaScaler could not normalise it."

#: mediascaler.php
msgid "MediaScaler"
msgstr "MediaScaler"

#: settings/MediaScaler.setting.php
msgid "Automatically process CiviCRM image uploads"
msgstr "Automatically process CiviCRM image uploads"

#: settings/MediaScaler.setting.php
msgid ""
"Enable contact-photo and generic-file interception. Explicit MediaScaler "
"service calls remain available when this is disabled."
msgstr ""
"Enable contact-photo and generic-file interception. Explicit MediaScaler "
"service calls remain available when this is disabled."

#: settings/MediaScaler.setting.php
msgid "Contact photos: correct EXIF orientation"
msgstr "Contact photos: correct EXIF orientation"

#: settings/MediaScaler.setting.php
msgid ""
"Read the EXIF orientation before transformation. EXIF, GPS and IPTC metadata"
" are still removed from the output."
msgstr ""
"Read the EXIF orientation before transformation. EXIF, GPS and IPTC metadata"
" are still removed from the output."

#: settings/MediaScaler.setting.php
msgid "Contact photos: crop to a fixed ratio"
msgstr "Contact photos: crop to a fixed ratio"

#: settings/MediaScaler.setting.php
msgid ""
"Enable the focal-point crop editor and crop every contact photo to the ratio"
" below."
msgstr ""
"Enable the focal-point crop editor and crop every contact photo to the ratio"
" below."

#: settings/MediaScaler.setting.php
msgid "Contact crop ratio width"
msgstr "Contact crop ratio width"

#: settings/MediaScaler.setting.php
msgid "Contact crop ratio height"
msgstr "Contact crop ratio height"

#: settings/MediaScaler.setting.php
msgid "Contact photos: limit pixel dimensions"
msgstr "Contact photos: limit pixel dimensions"

#: settings/MediaScaler.setting.php
msgid ""
"Reduce oversized images to fit within the maximum width and height. Smaller "
"images are not enlarged."
msgstr ""
"Reduce oversized images to fit within the maximum width and height. Smaller "
"images are not enlarged."

#: settings/MediaScaler.setting.php
msgid "Contact maximum width (pixels)"
msgstr "Contact maximum width (pixels)"

#: settings/MediaScaler.setting.php
msgid "Contact maximum height (pixels)"
msgstr "Contact maximum height (pixels)"

#: settings/MediaScaler.setting.php
msgid "Contact output quality (%)"
msgstr "Contact output quality (%)"

#: settings/MediaScaler.setting.php
msgid ""
"JPEG and WebP encoding quality. PNG remains lossless; this value controls "
"its compression effort."
msgstr ""
"JPEG and WebP encoding quality. PNG remains lossless; this value controls "
"its compression effort."

#: settings/MediaScaler.setting.php
msgid "Contact photos: apply output compression"
msgstr "Contact photos: apply output compression"

#: settings/MediaScaler.setting.php
msgid ""
"When disabled, the output quality is forced to 100%. Pixel resizing remains "
"independent."
msgstr ""
"When disabled, the output quality is forced to 100%. Pixel resizing remains "
"independent."

#: settings/MediaScaler.setting.php
msgid "Contact photos: generate a WebP derivative"
msgstr "Contact photos: generate a WebP derivative"

#: settings/MediaScaler.setting.php
msgid ""
"The compatible JPEG or PNG remains the primary CiviCRM file. WebP is only an"
" additional rendition."
msgstr ""
"The compatible JPEG or PNG remains the primary CiviCRM file. WebP is only an"
" additional rendition."

#: settings/MediaScaler.setting.php
msgid "Other images: correct EXIF orientation"
msgstr "Other images: correct EXIF orientation"

#: settings/MediaScaler.setting.php
msgid "Other images: crop to a fixed ratio"
msgstr "Other images: crop to a fixed ratio"

#: settings/MediaScaler.setting.php
msgid ""
"Use a centered crop with the ratio below. This does not add a focal-point "
"editor to generic file fields."
msgstr ""
"Use a centered crop with the ratio below. This does not add a focal-point "
"editor to generic file fields."

#: settings/MediaScaler.setting.php
msgid "Other images crop ratio width"
msgstr "Other images crop ratio width"

#: settings/MediaScaler.setting.php
msgid "Other images crop ratio height"
msgstr "Other images crop ratio height"

#: settings/MediaScaler.setting.php
msgid "Other images: limit pixel dimensions"
msgstr "Other images: limit pixel dimensions"

#: settings/MediaScaler.setting.php
msgid "Other images maximum width (pixels)"
msgstr "Other images maximum width (pixels)"

#: settings/MediaScaler.setting.php
msgid "Other images maximum height (pixels)"
msgstr "Other images maximum height (pixels)"

#: settings/MediaScaler.setting.php
msgid "Other images output quality (%)"
msgstr "Other images output quality (%)"

#: settings/MediaScaler.setting.php
msgid "Other images: apply output compression"
msgstr "Other images: apply output compression"

#: settings/MediaScaler.setting.php
msgid "Other images: generate a WebP derivative"
msgstr "Other images: generate a WebP derivative"
