msgstr "Filtrer les contributions par date de réception"

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid "Unfinished run detected"
msgstr "Lancement inachevé détecté"

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid "You have an unfinished run, do you want to continue with it?"
msgstr "Une émission n'est pas terminée. Voulez-vous la reprendre ?"

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid "Otherwise it <b>will be deleted</b>!"
msgstr "Sinon il <b>sera supprimé</b> !"

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid "An interrupted run has been detected. Do you want to continue with it?"
msgstr "Une émission interrompue a été détectée. Voulez-vous la reprendre ?"

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid "Otherwise the selection <b>will be deleted</b>!"
msgstr "Dans le cas contraire, la sélection <b>sera supprimée</b>."

#: templates/CRM/Donrec/Form/Task/remaining_snapshot.tpl
msgid ""
"<b>Caution!</b> Some receipts have already been created. If you do not "
"continue with this run, you should probably delete them manually."
msgstr ""
"<b>Attention !</b> Certains reçus fiscaux ont déjà été émis. Si vous ne "
"reprenez pas cette émission, vous devrez probablement les supprimer "
"manuellement."

