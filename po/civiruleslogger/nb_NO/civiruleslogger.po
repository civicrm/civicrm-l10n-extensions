#: CRM/Civiruleslogger/Page/ViewLog.php
msgid "View log for rule: \"%1\""
msgstr "Se log for regel: \"%1\""

#: CRM/Civiruleslogger/Page/ViewLog.php
msgid "Log entries %%StatusMessage%%"
msgstr "Loggoppføringer %%StatusMessage%%"

#: civiruleslogger.php
msgid "Logging"
msgstr "Loggføring"

#: civiruleslogger.php
msgid "There are %1 log entries"
msgstr "Det er %1 loggoppføringer"

#: schema/CivirulesLog.entityType.php
msgid "Civirules Log"
msgstr "CiviRegler logg"

#: schema/CivirulesLog.entityType.php
msgid "Civirules Logs"
msgstr "CiviRegler logger"

#: schema/CivirulesLog.entityType.php
msgid "Civirules logger log"
msgstr "CiviRegler loggføringslogg"

#: schema/CivirulesLog.entityType.php
msgid "ID"
msgstr "ID"

#: schema/CivirulesLog.entityType.php
msgid "Unique CivirulesLog ID"
msgstr "Unik CiviRegler-logg ID"

#: schema/CivirulesLog.entityType.php
#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Message"
msgstr "Melding"

#: schema/CivirulesLog.entityType.php
msgid "Standardized message"
msgstr "Standardisert melding"

#: schema/CivirulesLog.entityType.php
#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Context"
msgstr "Kontekst"

#: schema/CivirulesLog.entityType.php
msgid "JSON encoded data"
msgstr "JSON-kodet data"

#: schema/CivirulesLog.entityType.php
#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Level"
msgstr "Nivå"

#: schema/CivirulesLog.entityType.php
msgid "error level per PSR3"
msgstr "feilnivå pr PSR3"

#: schema/CivirulesLog.entityType.php
msgid "Timestamp"
msgstr "Tidsstempel"

#: schema/CivirulesLog.entityType.php
msgid "Timestamp of when event occurred."
msgstr "Tidsstempel får når hendelsen inntraff."

#: schema/CivirulesLog.entityType.php
msgid "Contact ID"
msgstr "Kontakt ID"

#: schema/CivirulesLog.entityType.php
msgid ""
"Optional Contact ID that created the log. Not an FK as we keep this "
"regardless"
msgstr "Valgfri kontakt-ID for den som opprettet loggen. Ikke en link, ettersom vi beholder denne uansett."

#: schema/CivirulesLog.entityType.php
msgid "Rule ID"
msgstr "Regel ID"

#: schema/CivirulesLog.entityType.php
msgid "Optional Rule ID that created the log"
msgstr "Valgfri Regel ID som skapte loggen"

#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Go back"
msgstr "Gå tilbake"

#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Time"
msgstr "Klokkeslett"

#: templates/CRM/Civiruleslogger/Page/ViewLog.tpl
msgid "Contact"
msgstr "Kontakt"
