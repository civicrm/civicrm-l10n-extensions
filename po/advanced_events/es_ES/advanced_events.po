#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Repeats"
msgstr "Se repite"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"Access the drop-down menus here to select how frequently your %1 occurs."
msgstr ""
"Acceda a los menús desplegables aquí para seleccionar con qué frecuencia "
"ocurre su %1."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"Example: You would select options \"1 month\", if your %1 occurs every "
"month."
msgstr ""
"Ejemplo: Seleccionaría las opciones \"1 mes\" si su %1 se ocurre cada mes."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"You can choose to select your %1 to repeat on weekdays, weekends or any "
"combination of day of the week."
msgstr ""
"Puede elegir que su %1 se repita en días laborables, fines de semana o "
"cualquier combinación de días de la semana."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"Example: You can select Monday, Wednesday and Friday for your %1 to occur on"
" alternate weekdays."
msgstr ""
"Ejemplo: Puede seleccionar Lunes, Miércoles y Viernes para que su %1 ocurra "
"en días laborables alternos."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Repeats by day of the month"
msgstr "Se repite por día del mes"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Options given here are days of a month from 1 - 31"
msgstr "Las opciones indicadas aquí son días de un mes del 1 al 31"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"Example: If your %1 repeats 8th of every month then you would select 8."
msgstr "Ejemplo: Si su %1 se repite el día 8 de cada mes, seleccionaría 8."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Repeats by day of the week"
msgstr "Se repite por día de la semana"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"You can choose to select %1 occurring every third Friday, last Monday, "
"fourth Wednesday of the month and various other combinations given in the "
"dropdown."
msgstr ""
"Puede elegir que %1 ocurra cada tercer Viernes, último Lunes, cuarto "
"Miércoles del mes y varias otras combinaciones indicadas en el desplegable."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Use this field to limit/end the repetition of the %1."
msgstr "Use este campo para limitar/finalizar la repetición de %1."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"Example: If you want to repeat an %1 6 times, then set 6 as a value for this"
" field."
msgstr ""
"Ejemplo: Si desea repetir un %1 6 veces, entonces establezca 6 como valor "
"para este campo."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Choose a specific date to limit/end the repetition."
msgstr "Elija una fecha específica para limitar/finalizar la repetición."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid "Exclude Date(s)"
msgstr "Excluir fecha(s)"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.hlp
msgid ""
"This field enables you to alter certain sessions, skip holidays, or create "
"gaps in the sequence for other reasons."
msgstr ""
"Este campo le permite alterar ciertas sesiones, omitir días festivos o crear"
" intervalos en la secuencia por otros motivos."

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.tpl
msgid "Repeat %1"
msgstr "Repetir %1"

#: templates/CRM/AdvancedEvents/Form/ManageEvent/RecurringEntity.tpl
