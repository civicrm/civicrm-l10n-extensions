#: exportpermission.php
msgid "CiviCRM Export Permissions"
msgstr "Permisos de Exportación de CiviCRM"

#: exportpermission.php
msgid "access export menu"
msgstr "acceder al menú de exportación"

#: exportpermission.php
msgid ""
"Access \"Export as CSV\" drop down menu item from actions menu on after "
"search/report"
msgstr ""
"Acceda a la opción del menú desplegable \"Exportar como CSV\" desde el menú "
"de acciones después de la búsqueda/informe."

#: exportpermission.php
msgid "access print menu"
msgstr "acceder al menú de impresión"

#: exportpermission.php
msgid "Access \"Print\" drop down menu item from actions menu on search/report"
msgstr ""
"Acceda a la opción del menú desplegable \"Imprimir\" desde el menú de "
"acciones en la búsqueda/informe."

#: exportpermission.php
msgid "access print pdf menu"
msgstr "acceder al menú de impresión de PDF"

#: exportpermission.php
msgid ""
"Access \"Print/Merge document (PDF Letter)\" drop down menu item from "
"actions menu on search/report"
msgstr ""
"Acceda a la opción del menú desplegable \"Imprimir/Combinar documento (PDF "
"Carta)\" desde el menú de acciones en la búsqueda/informe."

#: exportpermission.php
msgid "access mailing labels menu"
msgstr "acceder al menú de etiquetas de envío de correo"

#: exportpermission.php
msgid ""
"Access \"Print Mailing Labels\" drop down menu item from actions menu on "
"search/report"
msgstr ""
"Acceda a la opción del menú desplegable \"Imprimir Etiquetas de Envío de "
"Correo\" desde el menú de acciones en la búsqueda/informe."

#: exportpermission.php
msgid "You do not have permission to access this page."
msgstr "No tiene permiso para acceder a esta página."
